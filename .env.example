# Copy to .env in this folder. Used only by the optional Python slideshow tools
# (main.py, free_preview.py). The Growth OS web app uses web/.env instead.
# Leave a line blank if you are not using that tool.

# OpenAI — DALL-E images and GPT captions. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. free_preview.py --gemini. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional alternative caption engine. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# SocialClaw — scheduling posts to TikTok. https://getsocialclaw.com/dashboard
SOCIALCLAW_API_KEY=

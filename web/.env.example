# Growth OS — copy this file to web/.env and fill in your own values.
# Never commit .env. Leave optional lines blank until you need that feature.
# Names below match the running app. Do not rename them.

# ─── App ───────────────────────────────────────────────
# Public origin, no trailing slash. Local: http://localhost:3000
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
# Shown on Contact, Privacy, and Terms. Set both to the same address.
NEXT_PUBLIC_CONTACT_EMAIL=
CONTACT_EMAIL=

# ─── Database ──────────────────────────────────────────
# Local SQLite. Production: Supabase transaction pooler (port 6543), not the direct db host.
# Example shape (replace every part; do not use someone else's project):
# postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=10
DATABASE_URL="file:./dev.db"
# Same pooler URI, used by the one-off porting script only.
# SUPABASE_DATABASE_URL=
# PROD_DATABASE_URL=

# First signed-in user with this email can claim workspaces that have no owner yet.
OWNER_EMAIL=
# Optional fixed user id for that claim, or for local bypass.
# OWNER_USER_ID=

# Local only. Set to 1 to skip Supabase login. Never set this to 1 in production.
AUTH_DEV_BYPASS=0

# ─── Supabase Auth ─────────────────────────────────────
# Project Settings → API. https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
# JWT anon / public key (starts with eyJ). Required by @supabase/ssr.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional newer publishable key. The app does not read it yet.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Project Settings → API → service_role. Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for covers, avatars, and publish media. Created in Supabase Storage.
# SUPABASE_STORAGE_BUCKET=uploads
# SUPABASE_COVERS_BUCKET=uploads

# Encrypts integration keys saved in the database. Falls back to the service role key.
# INTEGRATIONS_SECRET=

# ─── AI ────────────────────────────────────────────────
# groq | openai | gemini | claude | ollama
AI_PROVIDER=groq
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_VISION_MODEL=gpt-4o-mini
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_VISION_MODEL=gemini-2.0-flash
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Local models. No key. https://ollama.com
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ─── TikTok Login Kit / Content Posting API ────────────
# https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must match the developer portal exactly. No trailing slash.
TIKTOK_REDIRECT_URI=http://localhost:3000/api/tiktok/oauth/callback
# TIKTOK_APP_AUDITED=false
# TIKTOK_DEBUG_ERRORS=0

# ─── Apify (TikTok profile sync on serverless hosts) ───
# https://console.apify.com/account/integrations
APIFY_TOKEN=
APIFY_TIKTOK_ACTOR=clockworks~tiktok-profile-scraper
# APIFY_TIKTOK_HASHTAG_ACTOR=clockworks~tiktok-scraper

# ─── Creator discovery ─────────────────────────────────
# https://tavily.com
# TAVILY_API_KEY=
# https://serper.dev
# SERPER_API_KEY=
# SERPER_KEY=

# ─── Outreach email (Resend) ───────────────────────────
# https://resend.com/api-keys
# RESEND_API_KEY=
# Until your domain is verified, Resend's shared test sender only delivers to your own inbox:
# OUTREACH_FROM_EMAIL=Collabs <onboarding@resend.dev>
# OUTREACH_REPLY_TO=you@example.com

# ─── Stripe billing ────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Customer portal login link from Stripe → Settings → Customer portal.
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_URL=
# stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Product ids (prod_...) from your own Stripe account. One product per plan.
STRIPE_PRODUCT_CREATOR=
STRIPE_PRODUCT_TEAM=
STRIPE_PRODUCT_PRO=
STRIPE_PRODUCT_AGENCY=
# Same ids, so the browser bundle can see them. Copy the four values above.
NEXT_PUBLIC_STRIPE_PRODUCT_CREATOR=
NEXT_PUBLIC_STRIPE_PRODUCT_TEAM=
NEXT_PUBLIC_STRIPE_PRODUCT_PRO=
NEXT_PUBLIC_STRIPE_PRODUCT_AGENCY=
# Optional. If set, checkout skips the Prices API lookup.
# STRIPE_PRICE_CREATOR=
# STRIPE_PRICE_TEAM=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_AGENCY=
# STRIPE_PRICE_ID_PRO=

# ─── Competitor intel ──────────────────────────────────
# https://www.facebook.com/ads/library/api
# META_AD_LIBRARY_TOKEN=
# META_ADS_PLAYWRIGHT=0
# INTEL_BROWSER_RATE_MS=1200
# DISABLE_PLAYWRIGHT=1
# FORCE_PLAYWRIGHT=0

# ─── Publish pacing (optional) ─────────────────────────
# PUBLISH_MIN_GAP_MINUTES=10
# PUBLISH_MAX_PER_DAY=10
# PUBLISH_MAX_PER_HOUR=3
# PUBLISH_STAGGER_GAP_MIN=3
# PUBLISH_STAGGER_GAP_MAX=5
# PUBLISH_MAX_RETRIES=3
# PUBLISH_RETRY_BACKOFF_BASE_MS=300000

# ─── Ops scripts (optional) ────────────────────────────
# LEGACY_WORKSPACE_SLUG=
# LEGACY_WORKSPACE_NAME=
# BASE_URL=http://localhost:3000
# LOG_PERSIST=0
# DEBUG_ENV=0
